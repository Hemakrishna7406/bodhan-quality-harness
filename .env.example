# Copy to .env and fill in. Never commit .env.

# --- Bodhan hosted API (keys are issued per model in console.bodhan.ai) ---
BODHAN_BASE_URL=https://api.bodhan.ai/v1
BODHAN_TRANSLATE_KEY=
BODHAN_SPEAK_KEY=
BODHAN_TRANSCRIBE_KEY=

# Optional model overrides
# BODHAN_TRANSLATE_MODEL=indic-translate
# BODHAN_SPEAK_MODEL=indic-speak
# BODHAN_TRANSCRIBE_MODEL=indic-transcribe-core

# --- Judge LLM (Sarvam AI, OpenAI-compatible; use sarvam-105b) ---
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=
